{
  "name": "@pulsadev/rpc-provider",
  "version": "0.1.0",
  "description": "Multi-RPC provider with load balancing, failover, health checks, and latency tracking — zero dependencies.",
  "license": "MIT",
  "author": "Yuto Nakamura <yuto.nakamura@proton.me>",
  "homepage": "https://pulsadev.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulsadev/rpc-provider"
  },
  "keywords": [
    "ethereum",
    "rpc",
    "provider",
    "load-balancing",
    "failover",
    "health-check",
    "evm",
    "web3",
    "typescript",
    "multi-rpc"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": { "node": ">=18.0.0" }
}
